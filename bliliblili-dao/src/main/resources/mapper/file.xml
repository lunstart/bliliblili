<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bliliblili.dao.FileDao">

    <insert id="addFile" parameterType="com.bliliblili.domain.entity.File">
        insert into
            t_file(
                url,
                `type`,
                md5,
                create_time
            )value(
                #{url},
                #{type},
                #{md5},
                #{createTime}
            )
    </insert>
    <delete id="deleteFileMD5" parameterType="java.lang.String">
        delete from
            t_file
        where
            url = #{filePath}
    </delete>

    <select id="getFileByMD5" parameterType="java.lang.String" resultType="com.bliliblili.domain.entity.File">
        select
            *
        from
            t_file
        where
            md5 = #{md5}
    </select>

    <select id="getFileNameByUrl" parameterType="java.lang.String" resultType="java.lang.String">
        select
            type
        from t_file
        where
            url = #{url}
    </select>

</mapper>
