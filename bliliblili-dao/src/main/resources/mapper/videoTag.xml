<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bliliblili.dao.VideoTagDao">


    <insert id="addVideoTag" parameterType="com.bliliblili.domain.entity.Tag" useGeneratedKeys="true" keyProperty="id">
        insert into t_tag
            (name, create_time)
        values (#{name},#{createTime})
    </insert>

    <delete id="deleteVideoTag" parameterType="java.lang.Long">
        delete
        from t_tag
        where id = #{tagId}
    </delete>

    <select id="getTagByName" parameterType="java.lang.String" resultType="com.bliliblili.domain.entity.Tag">
        select * from t_tag where name = #{name}
    </select>

</mapper>
